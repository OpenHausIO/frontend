    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.4",
    "dotenv": "^17.3.1",
    "grunt": "^1.6.1",
    "vite": "^7.3.1"
  }
}